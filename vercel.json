{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/sheets/cron",
      "schedule": "15 20 * * *"
    }
  ],
  "env": {
    "CLOUD_MODE": "true",
    "NODE_ENV": "production"
  }
}