{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)",     "dest": "/index.html"   }
  ],
  "env": {
    "CLOUD_MODE": "true",
    "NODE_ENV": "production"
  }
}
